from agent_baselines import Agent
import networkx as nx

class StudentAgent(Agent):
    '''
    Deterministic agent:
    - Coast-aware targeting for provinces (e.g., BUL/EC vs BUL/SC)
    - Targets all non-owned SCs (neutral + enemy)
    - Avoids self-bounces and swap-bounces
    - Uses simple supports and simple convoys if legal orders exist
    - Returns only valid orders from get_all_possible_orders()
    '''

    def __init__(self, agent_name='24128968'):
        super().__init__(agent_name)
        self.game = None
        self.power_name = None
        self.map_graph_army = None
        self.map_graph_navy = None

    def new_game(self, game, power_name):
        self.game = game
        self.power_name = power_name
        # Build graphs once per Game instance
        if not self.map_graph_army or not self.map_graph_navy:
            self.build_map_graphs()

    def update_game(self, all_power_orders):
        # Do not change this contract with the engine.
        for power_name in all_power_orders.keys():
            self.game.set_orders(power_name, all_power_orders[power_name])
        self.game.process()

    def build_map_graphs(self):
        if not self.game:
            raise Exception('Game Not Initialised. Cannot Build Map Graphs.')

        self.map_graph_army = nx.Graph()
        self.map_graph_navy = nx.Graph()

        locations = list(self.game.map.loc_type.keys())  # includes coast nodes like BUL/EC
        for loc in locations:
            lt = self.game.map.loc_type[loc]
            if lt in ('LAND', 'COAST'):
                self.map_graph_army.add_node(loc)
            if lt in ('WATER', 'COAST'):
                self.map_graph_navy.add_node(loc)

        # Deterministic ordering for edges
        sorted_locs = sorted(locations)
        for i in sorted_locs:
            for j in sorted_locs:
                if self.game.map.abuts('A', i, '-', j):
                    self.map_graph_army.add_edge(i, j)
                if self.game.map.abuts('F', i, '-', j):
                    self.map_graph_navy.add_edge(i, j)

    # ---------------- Helpers ----------------

    def _sanitize_orders(self, orders):
        # Keep only orders that are currently legal for any unit.
        possible_all = self.game.get_all_possible_orders()
        valid = set()
        for ops in possible_all.values():
            valid.update(ops)
        clean = []
        for o in orders:
            if isinstance(o, str):
                s = o.strip()
                if s in valid:
                    clean.append(s)
        return clean

    def _get_unit_type(self, loc):
        """Return 'A' or 'F' for the unit at loc, else None."""
        u_loc = (loc or '').upper()
        # Powers store units as strings like "A PAR", "F ENG"
        for power in self.game.powers.values():
            for unit in getattr(power, 'units', []):
                if isinstance(unit, str) and len(unit) >= 3:
                    unit_type = unit[0]
                    unit_loc = unit[2:].upper()
                    if unit_loc == u_loc:
                        return unit_type
        # Fallback via possible order prefixes at that loc
        poss = self.game.get_all_possible_orders().get(u_loc, [])
        if any(isinstance(o, str) and o.startswith('A ') for o in poss):
            return 'A'
        if any(isinstance(o, str) and o.startswith('F ') for o in poss):
            return 'F'
        return None

    def _coast_variants(self, prov):
        """
        Return node variants for a province: e.g., BUL -> ['BUL', 'BUL/EC', 'BUL/SC'] if they exist.
        """
        prov = (prov or '').upper()
        variants = []
        if prov in self.game.map.loc_type:
            variants.append(prov)
        for suf in ('/NC', '/SC', '/EC', '/WC'):
            key = prov + suf
            if key in self.game.map.loc_type:
                variants.append(key)
        return variants or [prov]

    def _graph_for_type(self, unit_type):
        return self.map_graph_navy if unit_type == 'F' else self.map_graph_army

    def _shortest_paths(self, graph, src):
        try:
            return nx.shortest_path(graph, source=(src or '').upper())
        except Exception:
            return {}

    def _next_step_towards(self, graph, src, dst):
        if not src or not dst:
            return None
        try:
            path = nx.shortest_path(graph, source=src, target=dst)
            if len(path) >= 2:
                return path[1]
        except Exception:
            return None
        return None

    def _distance_node(self, graph, src, dst_node):
        if not src or not dst_node:
            return float('inf')
        try:
            path = nx.shortest_path(graph, source=src, target=dst_node)
            return max(0, len(path) - 1)
        except Exception:
            return float('inf')

    def _distance_to_province(self, unit_type, src, prov):
        """Min distance from src to any node variant of prov for the given unit type."""
        graph = self._graph_for_type(unit_type)
        if not graph:
            return float('inf'), None
        best_d = float('inf')
        best_node = None
        for node in sorted(self._coast_variants(prov)):
            if node in graph.nodes:
                d = self._distance_node(graph, src, node)
                if d < best_d:
                    best_d = d
                    best_node = node
        return best_d, best_node

    def _centers_not_mine(self):
        all_centers = set(self.game.map.scs)
        my_centers = set(self.game.get_centers(self.power_name))
        return sorted(all_centers - my_centers)

    def _occupied_map(self):
        """Map node -> (owner, unit_type)."""
        occ = {}
        for pname, power in self.game.powers.items():
            for unit in getattr(power, 'units', []):
                if isinstance(unit, str) and len(unit) >= 3:
                    utype = unit[0]
                    uloc = unit[2:].upper()
                    occ[uloc] = (pname, utype)
        return occ

    def _has_supporter(self, support_core, exclude=None):
        """Return (sloc, s_order) if any of our units can issue ' S <support_core>' now."""
        exclude = exclude or set()
        all_possible_orders = self.game.get_all_possible_orders()
        for sloc in sorted(self.game.get_orderable_locations(self.power_name)):
            if sloc in exclude:
                continue
            sposs = all_possible_orders.get(sloc, [])
            s_order = next((so for so in sposs if f" S {support_core}" in so), None)
            if s_order:
                return sloc, s_order
        return None, None

    # New: choose exact move strings (supports coast variants)
    def _choose_move_string(self, possible, typ, src, dst_node):
        """
        Pick the exact move string from 'possible' matching src -> dst_node.
        Prefer direct move; use ' VIA' only if direct is unavailable.
        """
        tgt = f"{typ} {src} - {dst_node}"
        via = f"{tgt} VIA"
        if tgt in possible:
            return tgt
        if via in possible:
            return via
        return None

    def _choose_move_to_province(self, possible, typ, src, prov):
        """
        Find a legal move from src into any coast-variant node of prov.
        Returns (move_string, dst_node, core_without_via) or (None, None, None).
        """
        for v in sorted(self._coast_variants(prov)):
            mv = self._choose_move_string(possible, typ, src, v)
            if mv:
                return mv, v, mv.replace(' VIA', '')
        return None, None, None

    def _gather_convoyers(self, core, exclude=None):
        """
        Find all of our fleets that can issue ' C <core>' this phase.
        Returns list of (fleet_loc, convoy_order).
        """
        exclude = exclude or set()
        convoyers = []
        all_possible_orders = self.game.get_all_possible_orders()
        for floc in sorted(self.game.get_orderable_locations(self.power_name)):
            if floc in exclude:
                continue
            if self._get_unit_type(floc) != 'F':
                continue
            fposs = all_possible_orders.get(floc, [])
            c_order = next((po for po in fposs if f" C {core}" in po), None)
            if c_order:
                convoyers.append((floc, c_order))
        return convoyers

    # --- Ownership and pressure helpers ---
    def _owner_of_province(self, prov):
        """
        Return the owner of a base province (SC) or None if neutral/not an SC.
        """
        base = (prov or '').split('/')[0].upper()
        sc_bases = {s.split('/')[0].upper() for s in self.game.map.scs}
        if base not in sc_bases:
            return None
        for pname in self.game.powers.keys():
            try:
                centers = {c.split('/')[0].upper() for c in self.game.get_centers(pname)}
            except Exception:
                centers = set()
            if base in centers:
                return pname
        return None

    def _enemy_pressure(self):
        """
        Approximate enemy pressure: count how many enemy units could move
        into each adjacent node (graph-neighbor based; fast and engine-agnostic).
        """
        press = {}
        occ = self._occupied_map()
        for node, (owner, utype) in occ.items():
            if owner == self.power_name:
                continue
            graph = self._graph_for_type(utype)
            if not graph or node not in graph:
                continue
            for nbr in graph.neighbors(node):
                press[nbr] = press.get(nbr, 0) + 1
        return press

    # ---------------- Heuristic (optional, kept light) ----------------

    def heuristic(self):
        if not self.game:
            return 0.0
        score = 100.0 * len(self.game.get_centers(self.power_name))
        try:
            if not self.map_graph_army or not self.map_graph_navy:
                self.build_map_graphs()
        except Exception:
            pass
        # Mobility bonus
        orderable = sorted(self.game.get_orderable_locations(self.power_name))
        targets = self._centers_not_mine()
        for loc in orderable:
            unit_type = self._get_unit_type(loc)
            d, _ = self._distance_to_province(unit_type, loc, targets[0] if targets else None)
            if d < float('inf'):
                score += max(0, 10 - d)
        return score

    # ---------------- Core policy ----------------

    def get_actions(self):
        # Ensure graphs exist
        try:
            if not self.map_graph_army or not self.map_graph_navy:
                self.build_map_graphs()
        except Exception:
            pass

        raw_all_possible = self.game.get_all_possible_orders()
        all_possible_orders = {loc: sorted(ops) for loc, ops in raw_all_possible.items()}
        orderable_locations = sorted(self.game.get_orderable_locations(self.power_name))

        # Non-movement phases unchanged
        if self.game.phase_type != 'M':
            out = []
            targets = self._centers_not_mine()
            for loc in orderable_locations:
                possible = all_possible_orders.get(loc, [])
                if not possible:
                    continue
                if any(o.endswith(' B') for o in possible) and targets:
                    best = possible[0]
                    best_d = float('inf')
                    for b in possible:
                        if not b.endswith(' B'):
                            continue
                        parts = b.split()
                        if len(parts) >= 3:
                            unit_letter = parts[0]
                            site = parts[1].upper()
                            d, _ = self._distance_to_province(unit_letter, site, targets[0])
                            if d < best_d:
                                best, best_d = b, d
                    out.append(best)
                else:
                    out.append(possible[0])
            return self._sanitize_orders(out)

        # Movement phase
        orders = {}
        reserved_units = set()
        reserved_dests = set()
        move_cores = set()

        occupied = self._occupied_map()
        targets = set(self._centers_not_mine())
        enemy_press = self._enemy_pressure()

        def enemy_occupied_node(node):
            node = (node or '').upper()
            return node in occupied and occupied[node][0] != self.power_name

        def my_occupied_node(node):
            node = (node or '').upper()
            return node in occupied and occupied[node][0] == self.power_name

        def improves_distance(unit_type, src_node, dst_node):
            # True if this step reduces distance to any target SC
            if not targets or not src_node or not dst_node:
                return True
            best_src = float('inf')
            best_dst = float('inf')
            for t in targets:
                d_src, _ = self._distance_to_province(unit_type, src_node, t)
                d_dst, _ = self._distance_to_province(unit_type, dst_node, t)
                if d_src < best_src:
                    best_src = d_src
                if d_dst < best_dst:
                    best_dst = d_dst
            return best_dst < best_src

        def core_move_str(typ, src, dst):
            return f"{typ} {src} - {dst}"

        # Fall: secure centers you sit on (don’t walk off unowned SCs)
        cur_phase = self.game.get_current_phase() or ''
        is_fall_move = isinstance(cur_phase, str) and cur_phase.startswith('F')
        if is_fall_move:
            my_centers = set(self.game.get_centers(self.power_name))
            scs = set(self.game.map.scs)
            for loc in orderable_locations:
                if loc in reserved_units:
                    continue
                base = loc.split('/')[0]
                if base in scs and base not in my_centers:
                    poss = all_possible_orders.get(loc, [])
                    hold = next((o for o in poss if o.endswith(' H')), None)
                    if hold:
                        orders[loc] = hold
                        reserved_units.add(loc)

        # Step 1: direct captures into target SCs (reserve destinations)
        assigned_targets = set()
        for loc in orderable_locations:
            if loc in reserved_units:
                continue
            possible = all_possible_orders.get(loc, [])
            if not possible:
                continue
            typ = self._get_unit_type(loc)

            empty_capture = None  # may include optional supporter (s_loc, s_order)
            supported_occ_capture = None  # occupied captures require a supporter (and convoyers if VIA)

            for tgt in sorted(t for t in targets if t not in assigned_targets):
                tgt_nodes = [v for v in self._coast_variants(tgt)]
                if all(v in reserved_dests for v in tgt_nodes):
                    continue
                mv, dst_node, core = self._choose_move_to_province(possible, typ, loc, tgt)
                if not mv:
                    continue

                # Avoid moving into a tile we currently occupy unless it’s already moving out
                if my_occupied_node(dst_node):
                    existing = orders.get(dst_node)
                    if not (isinstance(existing, str) and ' - ' in existing):
                        continue

                # If this is a convoyed move (VIA), only accept if we can assign convoyers now
                if ' VIA' in mv:
                    convoyers = self._gather_convoyers(core, exclude=reserved_units | {loc})
                    if not convoyers:
                        continue  # cannot execute this convoy now

                # avoid swap-bounce and destination clashes
                if core_move_str(typ, dst_node, loc) in move_cores or dst_node in reserved_dests:
                    continue

                if not enemy_occupied_node(dst_node):
                    # Gate contested neutrals: if neutral and enemies can also enter, require support
                    owner = self._owner_of_province(tgt)
                    if owner is None and enemy_press.get(dst_node, 0) > 0:
                        s_loc, s_order = self._has_supporter(core, exclude=reserved_units | {loc})
                        if not s_order:
                            continue
                        empty_capture = (tgt, mv, dst_node, core, s_loc, s_order)
                    else:
                        empty_capture = (tgt, mv, dst_node, core, None, None)
                    break
                else:
                    # occupied: always require at least one adjacent supporter this turn
                    s_loc, s_order = self._has_supporter(core, exclude=reserved_units | {loc})
                    if not s_order:
                        continue
                    # if convoyed, we also require convoyers (checked above)
                    supported_occ_capture = (tgt, mv, dst_node, core, s_loc, s_order)

            if empty_capture:
                tgt, mv, dst_node, core, s_loc, s_order = empty_capture
                orders[loc] = mv
                reserved_units.add(loc)
                reserved_dests.add(dst_node)
                move_cores.add(core)
                if s_order:
                    orders[s_loc] = s_order
                    reserved_units.add(s_loc)
                # If this is a convoy, assign convoyers and reserve those sea tiles
                if ' VIA' in mv:
                    for floc, c_order in self._gather_convoyers(core, exclude=reserved_units):
                        orders[floc] = c_order
                        reserved_units.add(floc)
                        reserved_dests.add(floc)  # prevent friendly moves into convoy sea tiles
                assigned_targets.add(tgt)
                continue

            if supported_occ_capture:
                tgt, mv, dst_node, core, s_loc, s_order = supported_occ_capture
                orders[loc] = mv
                reserved_units.add(loc)
                reserved_dests.add(dst_node)
                move_cores.add(core)
                # assign supporter
                orders[s_loc] = s_order
                reserved_units.add(s_loc)
                # If convoyed, also assign convoyers and reserve those sea tiles
                if ' VIA' in mv:
                    for floc, c_order in self._gather_convoyers(core, exclude=reserved_units):
                        orders[floc] = c_order
                        reserved_units.add(floc)
                        reserved_dests.add(floc)  # prevent friendly moves into convoy sea tiles
                assigned_targets.add(tgt)

        # Step 1.5: opportunistic supports for already-chosen attacks
        for sloc in orderable_locations:
            if sloc in reserved_units:
                continue
            sposs = all_possible_orders.get(sloc, [])
            if not sposs:
                continue
            for atk_order in sorted(orders.values()):
                if ' - ' not in atk_order:
                    continue
                support_core = atk_order.replace(' VIA', '')
                s_order = next((so for so in sposs if f" S {support_core}" in so), None)
                if s_order:
                    orders[sloc] = s_order
                    reserved_units.add(sloc)
                    break

        # Step 2: advance toward nearest target SCs (avoid futile 1v1 pokes)
        for loc in orderable_locations:
            if loc in reserved_units:
                continue
            possible = all_possible_orders.get(loc, [])
            if not possible:
                continue
            typ = self._get_unit_type(loc)
            graph = self._graph_for_type(typ)
            if not graph:
                continue

            reachable = [t for t in sorted(targets) if any(v in graph.nodes for v in self._coast_variants(t))]

            chosen = None
            best_node_for_t = None
            best_t = None
            best_d = float('inf')
            for t in reachable:
                d, node = self._distance_to_province(typ, loc, t)
                if node is None:
                    continue
                if d < best_d:
                    best_t, best_d, best_node_for_t = t, d, node

            if best_t is not None and best_d < float('inf'):
                step = self._next_step_towards(graph, loc, best_node_for_t)
                if step and step not in reserved_dests:
                    # Avoid moving into our own tile unless it’s already moving out
                    if my_occupied_node(step):
                        existing = orders.get(step)
                        if not (isinstance(existing, str) and ' - ' in existing):
                            step = None
                    if step:
                        core = core_move_str(typ, loc, step)
                        # Require support for any enemy-occupied step (not just final target node)
                        if enemy_occupied_node(step):
                            s_loc, s_order = self._has_supporter(core, exclude=reserved_units | {loc})
                            if not s_order:
                                step = None
                        # Gate contested neutrals at final step if enemies can also enter
                        if step and step == best_node_for_t:
                            owner = self._owner_of_province(best_t)
                            if owner is None and enemy_press.get(step, 0) > 0:
                                s_loc2, s_order2 = self._has_supporter(core, exclude=reserved_units | {loc})
                                if not s_order2:
                                    step = None
                                else:
                                    orders[s_loc2] = s_order2
                                    reserved_units.add(s_loc2)
                        # Require progress for non-final advance to avoid oscillation
                        if step and step != best_node_for_t and not improves_distance(typ, loc, step):
                            step = None
                        if step and core_move_str(typ, step, loc) not in move_cores:
                            mv = self._choose_move_string(possible, typ, loc, step)
                            # Do not pick convoy here; prefer repositioning by non-VIA moves
                            if mv and ' VIA' not in mv:
                                chosen = mv

            # Fallback: reposition without futile 1v1 or unwanted VIA
            if not chosen:
                for o in possible:
                    if ' - ' not in o:
                        continue
                    if ' VIA' in o:
                        continue  # skip convoys in fallback
                    core = o.replace(' VIA', '')
                    try:
                        dst = core.split(' - ')[1].strip().upper()
                    except Exception:
                        continue
                    if dst in reserved_dests or core_move_str(typ, dst, loc) in move_cores:
                        continue
                    if my_occupied_node(dst):
                        continue
                    if enemy_occupied_node(dst):
                        s_loc, s_order = self._has_supporter(core, exclude=reserved_units | {loc})
                        if not s_order:
                            continue
                    # Only take fallback if it reduces distance to some target
                    if not improves_distance(typ, loc, dst):
                        continue
                    chosen = o
                    break
                if not chosen:
                    # last resort: hold or first legal order
                    chosen = possible[0]

            if chosen:
                orders[loc] = chosen
                reserved_units.add(loc)
                if ' - ' in chosen:
                    try:
                        dst = chosen.replace(' VIA', '').split(' - ')[1].strip().upper()
                    except Exception:
                        dst = None
                    if dst:
                        reserved_dests.add(dst)
                        move_cores.add(core_move_str(self._get_unit_type(loc), loc, dst))

        final = [orders[l] for l in sorted(orders.keys()) if orders.get(l)]
        return self._sanitize_orders(final)
